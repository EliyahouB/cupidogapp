rules_version = '2';
service cloud.firestore {
	match /databases/{database}/documents {
    
		// ============================================
		// FONCTIONS UTILITAIRES
		// ============================================
    
		function isSignedIn() {
			return request.auth != null;
		}
    
		function isOwner(userId) {
			return isSignedIn() && request.auth.uid == userId;
		}
    
		function isAdmin() {
			return isSignedIn() && (
				request.auth.uid == 'pNoNYjpzYeW1rnQiStF0RYJSiVJ2' ||
				request.auth.uid == 'NpQIlnKvd8fUmDnYpdiiekitAl52'
			);
		}
    
		// Vrai si le champ a la même valeur avant et après l'écriture
		// (un champ absent et un champ à null sont considérés égaux).
		function unchanged(field) {
			return request.resource.data.get(field, null) == resource.data.get(field, null);
		}

		function isProfessional() {
			return isSignedIn() && 
						 exists(/databases/$(database)/documents/professional_accounts/$(request.auth.uid)) &&
						 get(/databases/$(database)/documents/professional_accounts/$(request.auth.uid)).data.status == "approved";
		}
    
		// ============================================
		// COLLECTION GROUPS (pour recherche globale)
		// ============================================
    
		match /{path=**}/dogs/{dogId} {
			allow read: if request.auth != null;
		}
    
		// ============================================
		// USERS
		// ============================================
    
		// Ancienne règle d'écriture (avant correction C4, 22.11.2026), conservée pour retour arrière :
		// allow write: if isOwner(userId);

		// Correction C4 : l'app n'écrit que le jeton de notification (pushToken).
		match /users/{userId} {
			allow read: if isSignedIn();
			allow create, update: if isOwner(userId)
				&& request.resource.data.keys().hasOnly(['pushToken', 'pushTokenUpdatedAt'])
				&& request.resource.data.get('pushToken', '') is string
				&& request.resource.data.get('pushToken', '').size() < 300;
			allow delete: if isOwner(userId);

			match /dogs/{dogId} {
				allow read: if isSignedIn();
				allow write: if isOwner(userId);
			}
		}
    
		// ============================================
		// PROFILES
		// ============================================
    
		// Ancienne règle (avant correction C4, 22.11.2026), conservée pour retour arrière :
		// match /profiles/{profileId} {
		// 	allow read: if isSignedIn();
		// 	allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
		// 	allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
		// }

		// Correction C4 : abonnement, type de compte, statuts et vérifications
		// ne peuvent être changés que par le serveur (SDK admin) ou l'admin.
		function profileLockedFields() {
			return ['abonnement', 'subscriptionEndDate', 'subscription', 'userType', 'providerType',
							'providerStatus', 'phoneVerified', 'emailVerified', 'uid', 'isAdmin', 'createdAt'];
		}

		// Champ écrit une seule fois (absent -> valeur), jamais modifié ensuite
		function setOnce(field) {
			return unchanged(field) || resource.data.get(field, null) == null;
		}

		match /profiles/{profileId} {
			allow read: if isSignedIn();

			allow create: if isOwner(profileId)
				&& request.resource.data.uid == request.auth.uid
				&& request.resource.data.get('abonnement', 'gratuit') == 'gratuit'
				&& request.resource.data.get('subscription', 'none') == 'none'
				&& request.resource.data.get('providerStatus', 'pending') == 'pending'
				&& request.resource.data.get('userType', 'particulier') in ['particulier', 'professionnel']
				&& request.resource.data.get('providerType', null) in [null, 'prestataire', 'vendeur']
				&& !request.resource.data.keys().hasAny(['subscriptionEndDate', 'isAdmin', 'status',
						'freeBoosts', 'referredBy', 'referredByCode', 'legalDocumentVerified'])
				&& request.resource.data.get('totalConversationsCreated', 0) == 0
				&& (request.resource.data.get('emailVerified', false) == false
						|| request.auth.token.get('email_verified', false) == true)
				&& (request.resource.data.get('phoneVerified', false) == false
						|| request.auth.token.get('phone_number', null) != null);

			allow update: if isAdmin() || (isOwner(profileId)
				&& resource.data.uid == request.auth.uid
				&& !request.resource.data.diff(resource.data).affectedKeys().hasAny(profileLockedFields())
				// statut : l'utilisateur peut seulement se suspendre (seul l'admin change ou retire le statut)
				&& (unchanged('status') || request.resource.data.get('status', null) == 'suspendu')
				// compteur de conversations : inchangé ou +1 (jamais remis à zéro)
				&& (unchanged('totalConversationsCreated')
						|| request.resource.data.get('totalConversationsCreated', 0)
								== resource.data.get('totalConversationsCreated', 0) + 1)
				// parrainage : une seule fois
				&& setOnce('referredBy') && setOnce('referredByCode') && setOnce('usedReferralCode')
				&& (unchanged('freeBoosts')
						|| (resource.data.get('freeBoosts', 0) == 0 && request.resource.data.get('freeBoosts', 0) == 1))
				// validation du justificatif : l'app ne peut écrire que false
				&& (unchanged('legalDocumentVerified')
						|| request.resource.data.get('legalDocumentVerified', false) == false));

			// Suppression du compte (Réglages)
			allow delete: if isOwner(profileId) && resource.data.uid == request.auth.uid;
		}

		match /app_config/{documentId} {
			allow read: if isSignedIn();
			allow write: if isAdmin();
		}

		match /phone_otp_requests/{requestId} {
			allow read, write: if false;
		}

		match /phone_otp_rate_limits/{requestId} {
			allow read, write: if false;
		}
    
		// ============================================
		// MESSAGES
		// ============================================
    
		match /messages/{messageId} {
			allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
			allow create: if isSignedIn() && 
											 request.resource.data.fromUserId == request.auth.uid && 
											 request.auth.uid in request.resource.data.participants;
			allow delete: if isSignedIn() && resource.data.fromUserId == request.auth.uid;
			allow update: if false;
		}
    
		// ============================================
		// LIKES
		// ============================================
    
		match /likes/{likeId} {
			allow read: if isSignedIn();
			allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
			allow delete: if isSignedIn() && resource.data.fromUserId == request.auth.uid;
			allow update: if isSignedIn() &&
				request.auth.uid == resource.data.toOwnerId &&
				request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
		}
    
		// ============================================
		// MATCHES
		// ============================================
    
		match /matches/{matchId} {
			allow read: if isSignedIn() && (
				request.auth.uid in resource.data.users ||
				request.auth.uid == resource.data.user1 ||
				request.auth.uid == resource.data.user2
			);
			allow create: if isSignedIn();
			allow update: if isSignedIn() && (
				request.auth.uid in resource.data.users ||
				request.auth.uid == resource.data.user1 ||
				request.auth.uid == resource.data.user2
			);
			allow delete: if false;
		}
    
		// ============================================
		// CONVERSATIONS
		// ============================================
    
		match /conversations/{conversationId} {
			allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
			allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
			allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
			allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;
      
			match /messages/{messageId} {
				allow read: if isSignedIn() && 
					request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
				allow create: if isSignedIn() && 
					request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
					request.resource.data.senderId == request.auth.uid;
				allow delete: if isSignedIn() && 
					request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
					resource.data.senderId == request.auth.uid;
				allow update: if isSignedIn() &&
					request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
					resource.data.senderId != request.auth.uid &&
					request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
					request.resource.data.read == true;
			}
		}
    
		// ============================================
		// MARKETPLACE - SERVICES
		// ============================================
    
		match /marketplace_services/{serviceId} {
			allow read: if isSignedIn() && (
				isAdmin() ||
				resource.data.status == 'active' || 
				resource.data.providerId == request.auth.uid
			);
			allow create: if isProfessional() && 
											 request.auth.uid == request.resource.data.providerId;
			allow update: if isSignedIn() && (
				isAdmin() ||
				request.auth.uid == resource.data.providerId ||
				request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewsCount'])
			);
			allow delete: if isSignedIn() && request.auth.uid == resource.data.providerId;
		}
    
		// ============================================
		// MARKETPLACE - LEADS
		// ============================================
    
		match /marketplace_leads/{leadId} {
			allow read: if isSignedIn() && (
				isAdmin() ||
				resource.data.customerId == request.auth.uid ||
				resource.data.providerId == request.auth.uid
			);
			allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
			allow update: if isSignedIn() && (
				resource.data.customerId == request.auth.uid ||
				resource.data.providerId == request.auth.uid
			);
			allow delete: if false;
		}
    
		// ============================================
		// MARKETPLACE - PRODUCTS
		// ============================================
    
		match /marketplace_products/{productId} {
			allow read: if isSignedIn() && (
				isAdmin() ||
				resource.data.status == 'active' || 
				resource.data.sellerId == request.auth.uid
			);
			allow create: if isProfessional() && 
											 request.auth.uid == request.resource.data.sellerId;
			allow update: if isSignedIn() && request.auth.uid == resource.data.sellerId;
			allow delete: if isSignedIn() && request.auth.uid == resource.data.sellerId;
		}
    
		// ============================================
		// MARKETPLACE - ORDERS (ADMIN PEUT TOUT VOIR)
		// ============================================
    
		// Ancienne règle de création (avant correction C6, 21.11.2026), conservée pour retour arrière :
		// allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;

		// Correction C6 : une commande est créée "pending", sans aucun champ de paiement.
		// Seul le serveur (processMarketplacePayment) la passe en "payment_processing" puis "paid".
		match /marketplace_orders/{orderId} {
			allow read: if isSignedIn() && (
				isAdmin() ||
				resource.data.customerId == request.auth.uid ||
				resource.data.sellerId == request.auth.uid
			);
			allow create: if isSignedIn()
				&& request.resource.data.customerId == request.auth.uid
				&& request.resource.data.status == 'pending'
				&& !request.resource.data.keys().hasAny([
					'paidAt', 'paymentStatus', 'tranzilaConfirmation', 'lastFourDigits',
					'amountCharged', 'amountDisplayed', 'paymentAttemptAt', 'itemsAsSubmitted',
					'commissionRate', 'sellerIds', 'stockConflict', 'stuckAlertSentAt'
				]);
			allow update: if isAdmin();
			allow delete: if false;
		}
    
		// ============================================
		// MARKETPLACE - REVIEWS
		// ============================================
    
		match /marketplace_reviews/{reviewId} {
			allow read: if true;
			allow create: if isSignedIn();
			allow update: if isSignedIn() && resource.data.customerId == request.auth.uid;
			allow delete: if false;
		}
    
		// ============================================
		// REFERRALS (PARRAINAGE)
		// ============================================
    
		match /referrals/{odersferrId} {
			allow read: if isSignedIn();
			allow create: if isSignedIn();
			allow update: if isSignedIn() && (
				isAdmin() ||
				resource.data.referrerId == request.auth.uid
			);
			allow delete: if false;
		}
    
		// ============================================
		// PROFESSIONAL ACCOUNTS (ADMIN PEUT TOUT VOIR)
		// ============================================
    
		// Ancienne règle (avant correction C3, 16.11.2026), conservée pour retour arrière :
		// match /professional_accounts/{accountId} {
		// 	allow read: if isSignedIn();
		// 	allow create: if isOwner(accountId);
		// 	allow update: if isAdmin() || (isOwner(accountId) &&
		// 									 request.resource.data.status == resource.data.status);
		// 	allow delete: if false;
		// }

		// Correction C3 : lecture réservée au propriétaire et à l'admin ;
		// statut, token de carte et approbation non modifiables par le pro.
		match /professional_accounts/{accountId} {
			allow read: if isOwner(accountId) || isAdmin();
			allow create: if isOwner(accountId)
				&& request.resource.data.get('status', 'awaiting_token') in ['awaiting_token', 'pending']
				&& request.resource.data.get('tranzilaToken', null) == null
				&& request.resource.data.get('approvedAt', null) == null;
			allow update: if isAdmin() || (isOwner(accountId)
				&& unchanged('status')
				&& unchanged('tranzilaToken')
				&& unchanged('cardOnFile')
				&& unchanged('cardLastFourDigits')
				&& unchanged('approvedAt')
				&& unchanged('rejectedAt')
				&& unchanged('rejectionReason')
				&& (unchanged('subscriptionPlan')
					|| resource.data.get('subscriptionPlan', null) == null
					|| resource.data.get('status', null) != 'approved'));
			allow delete: if false;
		}
    
		// ============================================
		// INVOICES (ADMIN PEUT TOUT VOIR)
		// ============================================
    
		match /invoices/{invoiceId} {
			allow read: if isSignedIn() && (
				isAdmin() ||
				resource.data.customerId == request.auth.uid || 
				resource.data.providerId == request.auth.uid || 
				resource.data.sellerId == request.auth.uid
			);
			allow create: if isAdmin();
			allow update: if isAdmin();
			allow delete: if false;
		}
    
		// ============================================
		// SUBSCRIPTIONS
		// ============================================
    
		match /subscriptions/{subscriptionId} {
			allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
			allow create: if isAdmin();
			allow update: if isAdmin();
			allow delete: if false;
		}
    
		// ============================================
		// BOOSTS (écrits uniquement par le serveur)
		// ============================================

		// Achats de boost : lisibles seulement par l'acheteur et l'admin
		// (contiennent le prix, les 4 derniers chiffres de la carte, la confirmation).
		match /boosts/{boostDocId} {
			allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
			allow write: if false;
		}

		// Boosts en cours, par cible : lisibles par tout utilisateur connecté (tri des listes).
		match /active_boosts/{activeBoostId} {
			allow read: if isSignedIn();
			allow write: if false;
		}

		// ============================================
		// FCM TOKENS
		// ============================================
    
		match /fcm_tokens/{userId} {
			allow read, write: if isOwner(userId);
		}
    
		// ============================================
		// NOTIFICATIONS
		// ============================================
    
		match /notifications/{notificationId} {
			allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
			allow create: if isAdmin();
			allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
			allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
		}
	}
}
