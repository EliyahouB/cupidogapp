rules_version = '2';
service cloud.firestore {
	match /databases/{database}/documents {
    
		// ============================================
		// FONCTIONS UTILITAIRES
		// ============================================
    
		function isSignedIn() {
			return request.auth != null;
		}
    
		function isOwner(userId) {
			return isSignedIn() && request.auth.uid == userId;
		}
    
		function isAdmin() {
			return isSignedIn() && request.auth.uid == 'yKCj9DkdQJhmjNuSIdZR31ZbFCA2';
		}
    
		function isProfessional() {
			return isSignedIn() && 
						 exists(/databases/$(database)/documents/professional_accounts/$(request.auth.uid)) &&
						 get(/databases/$(database)/documents/professional_accounts/$(request.auth.uid)).data.status == "approved";
		}
    
		// ============================================
		// COLLECTION GROUPS (pour recherche globale)
		// ============================================
    
		match /{path=**}/dogs/{dogId} {
			allow read: if request.auth != null;
		}
    
		// ============================================
		// USERS
		// ============================================
    
		match /users/{userId} {
			allow read: if isSignedIn();
			allow write: if isOwner(userId);
      
			match /dogs/{dogId} {
				allow read: if isSignedIn();
				allow write: if isOwner(userId);
			}
		}
    
		// ============================================
		// PROFILES
		// ============================================
    
		match /profiles/{profileId} {
			allow read: if isSignedIn();
			allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
			allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
		}

		match /app_config/{documentId} {
			allow read: if isSignedIn();
			allow write: if isAdmin();
		}

		match /phone_otp_requests/{requestId} {
			allow read, write: if false;
		}

		match /phone_otp_rate_limits/{requestId} {
			allow read, write: if false;
		}
    
		// ============================================
		// MESSAGES
		// ============================================
    
		match /messages/{messageId} {
			allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
			allow create: if isSignedIn() && 
											 request.resource.data.fromUserId == request.auth.uid && 
											 request.auth.uid in request.resource.data.participants;
			allow delete: if isSignedIn() && resource.data.fromUserId == request.auth.uid;
			allow update: if false;
		}
    
		// ============================================
		// LIKES
		// ============================================
    
		match /likes/{likeId} {
			allow read: if isSignedIn();
			allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
			allow delete: if isSignedIn() && resource.data.fromUserId == request.auth.uid;
			allow update: if false;
		}
    
		// ============================================
		// MATCHES
		// ============================================
    
		match /matches/{matchId} {
			allow read: if isSignedIn() && (
				request.auth.uid in resource.data.users ||
				request.auth.uid == resource.data.user1 ||
				request.auth.uid == resource.data.user2
			);
			allow create: if isSignedIn();
			allow update: if isSignedIn() && (
				request.auth.uid in resource.data.users ||
				request.auth.uid == resource.data.user1 ||
				request.auth.uid == resource.data.user2
			);
			allow delete: if false;
		}
    
		// ============================================
		// CONVERSATIONS
		// ============================================
    
		match /conversations/{conversationId} {
			allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
			allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
			allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
			allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;
      
			match /messages/{messageId} {
				allow read: if isSignedIn() && 
					request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
				allow create: if isSignedIn() && 
					request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
					request.resource.data.senderId == request.auth.uid;
				allow delete: if isSignedIn() && 
					request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
					resource.data.senderId == request.auth.uid;
				allow update: if false;
			}
		}
    
		// ============================================
		// MARKETPLACE - SERVICES
		// ============================================
    
		match /marketplace_services/{serviceId} {
			allow read: if isSignedIn() && (
				isAdmin() ||
				resource.data.status == 'active' || 
				resource.data.providerId == request.auth.uid
			);
			allow create: if isProfessional() && 
											 request.auth.uid == request.resource.data.providerId;
			allow update: if isSignedIn() && (
				isAdmin() ||
				request.auth.uid == resource.data.providerId ||
				request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewsCount'])
			);
			allow delete: if isSignedIn() && request.auth.uid == resource.data.providerId;
		}
    
		// ============================================
		// MARKETPLACE - LEADS
		// ============================================
    
		match /marketplace_leads/{leadId} {
			allow read: if isSignedIn() && (
				isAdmin() ||
				resource.data.customerId == request.auth.uid ||
				resource.data.providerId == request.auth.uid
			);
			allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
			allow update: if isSignedIn() && (
				resource.data.customerId == request.auth.uid ||
				resource.data.providerId == request.auth.uid
			);
			allow delete: if false;
		}
    
		// ============================================
		// MARKETPLACE - PRODUCTS
		// ============================================
    
		match /marketplace_products/{productId} {
			allow read: if isSignedIn() && (
				isAdmin() ||
				resource.data.status == 'active' || 
				resource.data.sellerId == request.auth.uid
			);
			allow create: if isProfessional() && 
											 request.auth.uid == request.resource.data.sellerId;
			allow update: if isSignedIn() && request.auth.uid == resource.data.sellerId;
			allow delete: if isSignedIn() && request.auth.uid == resource.data.sellerId;
		}
    
		// ============================================
		// MARKETPLACE - ORDERS (ADMIN PEUT TOUT VOIR)
		// ============================================
    
		match /marketplace_orders/{orderId} {
			allow read: if isSignedIn() && (
				isAdmin() ||
				resource.data.customerId == request.auth.uid ||
				resource.data.sellerId == request.auth.uid
			);
			allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
			allow update: if isAdmin();
			allow delete: if false;
		}
    
		// ============================================
		// MARKETPLACE - REVIEWS
		// ============================================
    
		match /marketplace_reviews/{reviewId} {
			allow read: if true;
			allow create: if isSignedIn();
			allow update: if isSignedIn() && resource.data.customerId == request.auth.uid;
			allow delete: if false;
		}
    
		// ============================================
		// REFERRALS (PARRAINAGE)
		// ============================================
    
		match /referrals/{odersferrId} {
			allow read: if isSignedIn();
			allow create: if isSignedIn();
			allow update: if isSignedIn() && (
				isAdmin() ||
				resource.data.referrerId == request.auth.uid
			);
			allow delete: if false;
		}
    
		// ============================================
		// PROFESSIONAL ACCOUNTS (ADMIN PEUT TOUT VOIR)
		// ============================================
    
		match /professional_accounts/{accountId} {
			allow read: if isSignedIn();
			allow create: if isOwner(accountId);
			allow update: if isAdmin() || (isOwner(accountId) && 
											 request.resource.data.status == resource.data.status);
			allow delete: if false;
		}
    
		// ============================================
		// INVOICES (ADMIN PEUT TOUT VOIR)
		// ============================================
    
		match /invoices/{invoiceId} {
			allow read: if isSignedIn() && (
				isAdmin() ||
				resource.data.customerId == request.auth.uid || 
				resource.data.providerId == request.auth.uid || 
				resource.data.sellerId == request.auth.uid
			);
			allow create: if isAdmin();
			allow update: if isAdmin();
			allow delete: if false;
		}
    
		// ============================================
		// SUBSCRIPTIONS
		// ============================================
    
		match /subscriptions/{subscriptionId} {
			allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
			allow create: if isAdmin();
			allow update: if isAdmin();
			allow delete: if false;
		}
    
		// ============================================
		// FCM TOKENS
		// ============================================
    
		match /fcm_tokens/{userId} {
			allow read, write: if isOwner(userId);
		}
    
		// ============================================
		// NOTIFICATIONS
		// ============================================
    
		match /notifications/{notificationId} {
			allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
			allow create: if isAdmin();
			allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
			allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
		}
	}
}
